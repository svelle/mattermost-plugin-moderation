{
    "id": "com.mattermost.community-moderation",
    "name": "Community Moderation",
    "description": "Community moderation tools for Mattermost — member reporting, a moderation queue, mutes, timeouts, warnings, and member management without the System Console.",
    "homepage_url": "https://github.com/svelle/mattermost-plugin-moderation",
    "support_url": "https://github.com/svelle/mattermost-plugin-moderation/issues",
    "icon_path": "assets/icon.svg",
    "min_server_version": "6.2.1",
    "server": {
        "executables": {
            "linux-amd64": "server/dist/plugin-linux-amd64",
            "linux-arm64": "server/dist/plugin-linux-arm64",
            "darwin-amd64": "server/dist/plugin-darwin-amd64",
            "darwin-arm64": "server/dist/plugin-darwin-arm64",
            "windows-amd64": "server/dist/plugin-windows-amd64.exe"
        }
    },
    "webapp": {
        "bundle_path": "webapp/dist/main.js"
    },
    "settings_schema": {
        "header": "Moderation behavior",
        "footer": "",
        "settings": [
            {
                "key": "HideBannedMessages",
                "display_name": "Hide messages from banned members",
                "type": "bool",
                "default": true,
                "help_text": "When a member is banned, hide their recent messages in the channel where the ban was issued."
            },
            {
                "key": "ReportRateLimit",
                "display_name": "Maximum reports per member",
                "type": "number",
                "default": 5,
                "help_text": "How many reports one member can submit within the time window below. Reports beyond the limit are rejected with a friendly message. Set to 0 to disable rate limiting."
            },
            {
                "key": "ReportRateWindowMinutes",
                "display_name": "Report rate limit window (minutes)",
                "type": "number",
                "default": 10,
                "help_text": "The rolling time window used for the report rate limit."
            },
            {
                "key": "BannedMessageMode",
                "display_name": "Banned message display",
                "type": "radio",
                "default": "placeholder",
                "options": [
                    {
                        "display_name": "Show placeholder",
                        "value": "placeholder"
                    },
                    {
                        "display_name": "Remove completely",
                        "value": "remove"
                    }
                ],
                "help_text": "Show a placeholder in place of each hidden message, or remove the messages entirely."
            }
        ]
    }
}
